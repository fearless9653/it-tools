{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["src/**/*", "src/**/*.vue", "**/*.d.ts", "node_modules/vite-plugin-pwa/client.d.ts"],
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "es2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // figue 的 package.json "exports" 缺少 "types" 字段，
      // 在 moduleResolution: "Bundler" 下无法解析到其自带的 index.d.ts。
      // 显式映射以保留真实类型（否则会退化为 any）。
      "figue": ["./node_modules/figue/dist/index.d.ts"]
    },
    "types": [
      "naive-ui/volar",
      "@intlify/unplugin-vue-i18n/messages",
      "unplugin-icons/types/vue",
      "vite/client",
      "vite-svg-loader"
    ],
    "esModuleInterop": true,
    "jsx": "preserve",
    "skipLibCheck": true
  }
}
